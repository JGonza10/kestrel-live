# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub.

# --- Flask ---
# Genera uno con:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# En http://localhost Chrome acepta cookies Secure; si usas otro host sin HTTPS, ponlo en false.
SESSION_COOKIE_SECURE=true
SESSION_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Llave para cifrar las claves de transmisión. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=kestrel
POSTGRES_PASSWORD=
POSTGRES_DB=kestrel_live
DATABASE_URL=postgresql+psycopg://kestrel:CAMBIA_ESTA_CONTRASEÑA@localhost:5432/kestrel_live

# --- LiveKit (docker-compose) ---
# El secreto debe tener al menos 32 caracteres.
LIVEKIT_API_KEY=kestrel
LIVEKIT_API_SECRET=
LIVEKIT_URL=http://localhost:7880
LIVEKIT_WS_URL=ws://localhost:7880

# Página que Egress abre para que lo que sale al aire sea idéntico al lienzo del estudio
# (banners, logo, nombres y diseño). Déjala vacía para usar la plantilla genérica de LiveKit.
EGRESS_TEMPLATE_URL=http://host.docker.internal:5173/salida

# --- Comentarios en vivo (opcionales) ---
# YouTube: crea una "Clave de API" en console.cloud.google.com con "YouTube Data API v3" activada.
YOUTUBE_API_KEY=
# Facebook: token de acceso de tu Página (permiso pages_read_engagement) desde developers.facebook.com.
FACEBOOK_PAGE_TOKEN=

# --- Biblioteca ---
# Las transmisiones en vivo también se guardan en MP4 (en recordings/). Pon false para no grabarlas.
RECORD_LIVE=true

# --- Kestrel IA (opcional) ---
# Llave de console.anthropic.com para resumen, capítulos, clips sugeridos y pregunta destacada.
# Los subtítulos en vivo y la moderación del chat no la necesitan.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
